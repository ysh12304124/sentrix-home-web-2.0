        sentrix => {
            SubDirectory => {
                TagTable => 'Image::ExifTool::UserDefined::sentrix',
            },
        },
    },
);

%Image::ExifTool::UserDefined::sentrix = (
    GROUPS => { 0 => 'XMP', 1 => 'XMP-sentrix', 2 => 'Location' },
    NAMESPACE => { sentrix => 'urn:sentrix:media:1.0/' },
    WRITABLE => 'string',
    PreciseAddress => {},
    AddressSource => {},
    AddressSourceSHA256 => {},
);

1;
