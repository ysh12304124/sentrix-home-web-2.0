+++ b/apps/api/src/sentrix/infrastructure/assistant/context_contract.py
@@ -0,0 +1,17 @@
+from pathlib import Path
+import json
+EXPECTED = {"contract_version": "sentrix2_native_16k_v1", "context_window_tokens": 16384,
+            "max_input_tokens": 13926, "max_output_tokens": 2048, "safety_tokens": 128,
+            "prompt_compaction_ratio": 0.85, "prompt_tokens_include_tools_and_template": True,
+            "thinking": False}
+def validate_contract(value, served_context_tokens):
+    for key, expected in EXPECTED.items():
+        if type(value.get(key)) is not type(expected) or value.get(key) != expected:
+            raise ValueError("unsupported context contract: " + key)
+    if served_context_tokens < 16384:
+        raise ValueError("model endpoint per-request capacity is below 16384")
+    return dict(EXPECTED)
+def load_contract(path, served_context_tokens):
+    if path is None: return None
+    if served_context_tokens is None: raise ValueError("endpoint context capacity is unknown")
+    return validate_contract(json.loads(Path(path).read_text()), served_context_tokens)
