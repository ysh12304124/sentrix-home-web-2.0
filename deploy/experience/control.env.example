# 控制面环境（示例，不含密钥）。安装到 /etc/sentrix/control.env，权限 0600。
SENTRIX_CONTROL_DB_PATH=/srv/sentrix/control/control.db
SENTRIX_CONTROL_FEEDBACK_DIR=/srv/sentrix/control/feedback
SENTRIX_CONTROL_LISTEN_HOST=0.0.0.0
SENTRIX_CONTROL_LISTEN_PORT=8210
SENTRIX_CONTROL_TLS_CERT_FILE=/etc/sentrix/tls/control.crt
SENTRIX_CONTROL_TLS_KEY_FILE=/etc/sentrix/tls/control.key

SENTRIX_CONTROL_USERS_FILE=/etc/sentrix/users.json
SENTRIX_CONTROL_MODEL_CLIENTS_FILE=/etc/sentrix/model-clients.json

SENTRIX_CONTROL_MODEL_UPSTREAM_URL=http://127.0.0.1:8100/v1
SENTRIX_CONTROL_MODEL_ID=qwen35-q4km
SENTRIX_CONTROL_MODEL_SLOTS=2
SENTRIX_CONTROL_MODEL_UPSTREAM_API_KEY=

# 153 实测端点；8103 侧车必须由 systemd 常驻。
SENTRIX_CONTROL_BGE_HEALTH_URL=http://127.0.0.1:8101/health
SENTRIX_CONTROL_CLIP_HEALTH_URL=http://127.0.0.1:8103/health

SENTRIX_CONTROL_SAMPLE_INTERVAL_S=10
SENTRIX_CONTROL_RESTART_UNITS=sentrix-experience-api@alice.service,sentrix-experience-api@bob.service,sentrix-experience-control.service
# 共享模型单元：重启前管理台会提示影响全部用户。
SENTRIX_CONTROL_SHARED_MODEL_UNITS=sentrix-experience-llama.service
# 仍直连 8100、未接入控制入口的消费者；非空时管理台标注“未纳入调度”。
SENTRIX_CONTROL_UNMANAGED_MODEL_CONSUMERS=
SENTRIX_CONTROL_QUEUE_WAIT_WARN_S=300

SENTRIX_CONTROL_METRIC_RETENTION_DAYS=30
SENTRIX_CONTROL_AUDIT_RETENTION_DAYS=90
SENTRIX_CONTROL_FEEDBACK_RETENTION_DAYS=90
SENTRIX_CONTROL_SESSION_IDLE_S=28800
SENTRIX_CONTROL_SESSION_MAX_S=604800
SENTRIX_CONTROL_SECURE_COOKIE=true
SENTRIX_CONTROL_BUILD_SHA=development
