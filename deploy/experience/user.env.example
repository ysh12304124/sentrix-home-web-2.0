# 每用户 API 环境（示例，不含密钥）。安装到 /etc/sentrix/user-<account>.env，权限 0600。
SENTRIX_DATA_DIR=/srv/sentrix/users/alice
SENTRIX_API_PORT=8301
SENTRIX_DEPLOYMENT_PROFILE=server

# 体验入口：只接受控制面转发，直连回环端口没有令牌也不可读。
SENTRIX_REQUIRE_INTERNAL_TOKEN=1
SENTRIX_INTERNAL_TOKEN=replace-with-long-random-token
SENTRIX_EXPERIENCE_MODE=1

# 固定 legacy：BGE-M3 1024 维 + Chinese-CLIP 768 维。
SENTRIX_EMBEDDING_SCHEME=legacy
SENTRIX_TEXT_EMBEDDER_URL=http://127.0.0.1:8101
SENTRIX_LEGACY_CLIP_URL=http://127.0.0.1:8103

# 主模型：经控制面准入，不直连 8100。
SENTRIX_VLM_BASE_URL=http://127.0.0.1:8210/internal/model/v1
SENTRIX_MODEL_GATEWAY_TOKEN=replace-with-model-gateway-token

FACE_PROVIDERS=CUDAExecutionProvider,CPUExecutionProvider
RETINAFACE_PROVIDERS=CUDAExecutionProvider,CPUExecutionProvider

SENTRIX_UPLOAD_QUOTA_BYTES=21474836480
SENTRIX_UPLOAD_PHOTO_MAX_BYTES=262144000
SENTRIX_UPLOAD_VIDEO_MAX_BYTES=2147483648
SENTRIX_UPLOAD_MIN_FREE_BYTES=107374182400
